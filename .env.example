# Run ./backend/mkdocsweb keygen; keep this key outside Git and back it up securely.
MASTER_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
APP_ORIGIN=https://notes.example.com
DATA_FILE=./data/mkdocsweb.db
STATIC_DIR=./dist
# Reverse proxy on the same host, backend bound to loopback only:
LISTEN_ADDR=127.0.0.1:8080
TRUSTED_PROXY_CIDR=127.0.0.1/32
# Or remove TRUSTED_PROXY_CIDR and configure direct HTTPS:
# TLS_CERT_FILE=./certs/fullchain.pem
# TLS_KEY_FILE=./certs/privkey.pem
# LISTEN_ADDR=0.0.0.0:8443
