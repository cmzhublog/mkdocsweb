# Docker Compose: no TLS required locally. Open exactly this origin.
APP_ORIGIN=http://localhost:8080
APP_PORT=8080
BIND_ADDR=127.0.0.1
ALLOW_HTTP=true
ADMIN_USERNAME=admin
# After adding Nginx HTTPS, set APP_ORIGIN=https://your-domain,
# ALLOW_HTTP=false and the actual trusted proxy source CIDR.
TRUSTED_PROXY_CIDR=
# Secrets are generated by scripts/setup-compose.sh into ignored .secrets/.
